# Server only. Copy to .env at repository root and restart. Never put keys in VITE_*.
OPENAI_API_KEY=
AI_UNDERSTANDING_PROVIDER=openai
AI_GENERATION_PROVIDER=openai
AI_MATCHING_PROVIDER=openai
AI_VISION_MODEL=gpt-4.1-mini
AI_IMAGE_MODEL=gpt-image-1.5
AI_MATCH_MODEL=gpt-4.1-mini
AI_BATCH_SIZE=5
AI_TIMEOUT_SECONDS=120
